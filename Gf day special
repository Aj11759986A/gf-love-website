<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Happy Girlfriend Day ❤️</title>

<link rel="stylesheet" href="style.css">

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&display=swap" rel="stylesheet">
</head>

<body>

<div class="hearts"></div>

<audio id="bgmusic" loop>
<source src="music/romantic.mp3" type="audio/mpeg">
</audio>

<!-- PASSWORD PAGE -->

<section id="login">

<div class="glass">

<h1>❤️ Our Secret World ❤️</h1>

<p>Enter Our Passcode</p>

<input type="password" id="pass" placeholder="Passcode">

<button onclick="checkPass()">Unlock ❤️</button>

<p id="wrong"></p>

</div>

</section>

<!-- HOME -->

<section id="home">

<div class="rainbow"></div>

<h1 class="title"></h1>

<p class="subtitle">

Every Love Story is Beautiful ❤️

But Ours is My Favorite...

</p>

<button onclick="nextPage()">

Open My Heart ❤️

</button>

</section>

<script src="script.js"></script>

</body>
</html>*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{
background:linear-gradient(-45deg,#ff0080,#ff4da6,#ff99cc,#ffd6e7,#ffffff,#ff66b2);
background-size:400% 400%;
animation:bg 10s ease infinite;
overflow:hidden;
height:100vh;
color:white;
}

@keyframes bg{
0%{background-position:0% 50%;}
50%{background-position:100% 50%;}
100%{background-position:0% 50%;}
}

section{
width:100%;
height:100vh;
display:flex;
justify-content:center;
align-items:center;
flex-direction:column;
}

#home{
display:none;
text-align:center;
padding:20px;
}

.glass{
width:90%;
max-width:380px;
padding:30px;
background:rgba(255,255,255,.15);
border-radius:25px;
backdrop-filter:blur(15px);
box-shadow:0 0 30px rgba(255,255,255,.3);
text-align:center;
}

.glass h1{
font-size:32px;
margin-bottom:20px;
}

.glass p{
margin-bottom:20px;
font-size:18px;
}

input{
width:100%;
padding:15px;
border:none;
outline:none;
border-radius:15px;
font-size:18px;
margin-bottom:20px;
text-align:center;
}

button{
padding:15px 35px;
border:none;
border-radius:40px;
background:#ff0066;
color:white;
font-size:20px;
cursor:pointer;
transition:.3s;
box-shadow:0 0 20px #ff0066;
animation:beat 1s infinite;
}

button:hover{
transform:scale(1.08);
}

@keyframes beat{
0%{transform:scale(1);}
50%{transform:scale(1.08);}
100%{transform:scale(1);}
}

.title{
font-size:45px;
margin-bottom:20px;
text-shadow:0 0 20px white;
animation:fade 2s;
}

.subtitle{
font-size:22px;
line-height:35px;
max-width:700px;
margin-bottom:40px;
animation:fade 3s;
}

@keyframes fade{
from{
opacity:0;
transform:translateY(50px);
}
to{
opacity:1;
transform:translateY(0);
}
}

/* Floating Hearts */

.hearts{
position:fixed;
left:0;
top:0;
width:100%;
height:100%;
overflow:hidden;
pointer-events:none;
}

.hearts span{
position:absolute;
bottom:-50px;
font-size:25px;
animation:float 10s linear infinite;
opacity:.8;
}

@keyframes float{

0%{
transform:translateY(0) rotate(0);
opacity:0;
}

20%{
opacity:1;
}

100%{
transform:translateY(-120vh) rotate(360deg);
opacity:0;
}

}

.rainbow{
position:absolute;
width:500px;
height:500px;
background:radial-gradient(circle,
red,
orange,
yellow,
green,
cyan,
blue,
violet,
transparent);

filter:blur(120px);

animation:rotate 8s linear infinite;

z-index:-1;
}

@keyframes rotate{

from{
transform:rotate(0deg);
}

to{
transform:rotate(360deg);
}

}

#wrong{
margin-top:15px;
color:yellow;
font-weight:bold;
}

@media(max-width:700px){

.title{
font-size:32px;
}

.subtitle{
font-size:18px;
line-height:30px;
}

button{
font-size:18px;
}

.glass h1{
font-size:25px;
}

}// ===== PASSWORD =====

const PASSWORD = "0727";

function checkPass(){

const input = document.getElementById("pass").value;

if(input === PASSWORD){

document.getElementById("login").style.display="none";

document.getElementById("home").style.display="flex";

document.getElementById("bgmusic").play();

typeWriter();

}

else{

document.getElementById("wrong").innerHTML="❌ Wrong Passcode ❤️";

}

}



// ===== TYPING TEXT =====

const text="Happy Girlfriend Day ❤️";

let i=0;

function typeWriter(){

if(i<text.length){

document.querySelector(".title").innerHTML+=text.charAt(i);

i++;

setTimeout(typeWriter,120);

}

}



// ===== NEXT PAGE =====

function nextPage(){

alert("❤️ Welcome My Love ❤️\n\nAb asli surprise shuru hone wala hai...");

}



// ===== FLOATING HEARTS =====

const heartContainer=document.querySelector(".hearts");

function createHeart(){

const heart=document.createElement("span");

heart.innerHTML="❤️";

heart.style.left=Math.random()*100+"vw";

heart.style.fontSize=(20+Math.random()*35)+"px";

heart.style.animationDuration=(5+Math.random()*5)+"s";

heartContainer.appendChild(heart);

setTimeout(()=>{

heart.remove();

},10000);

}

setInterval(createHeart,250);



// ===== MUSIC BUTTON (Future) =====

const music=document.getElementById("bgmusic");

music.volume=0.7;
